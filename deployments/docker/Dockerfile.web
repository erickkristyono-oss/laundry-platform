# syntax=docker/dockerfile:1
# Build with: docker build -f deployments/docker/Dockerfile.web -t laundry-web .
# (build context must be the repo root.)
FROM node:22-alpine AS build
WORKDIR /src/web

COPY web/package.json web/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci

COPY web/ ./
ARG NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
# Next.js's own incremental build cache — persists across image rebuilds
# via this cache mount, same reasoning as the Go cache mounts in
# Dockerfile.service/.gateway.
RUN --mount=type=cache,target=/src/web/.next/cache npm run build

FROM node:22-alpine
WORKDIR /app
RUN addgroup -S app && adduser -S app -G app

COPY --from=build /src/web/public ./public
COPY --from=build /src/web/.next/standalone ./
COPY --from=build /src/web/.next/static ./.next/static

USER app
ENV PORT=3000
EXPOSE 3000
CMD ["node", "server.js"]
