# Copy to deployments/docker/.env (docker compose auto-loads a .env file
# next to the compose file it was invoked with -f) to set secrets that
# should never be hardcoded into docker-compose.yml.

# Fonnte (fonnte.com) WhatsApp device token — see docs/14-architecture-decisions.md
# ADR-016. Leave unset for local dev: Notification Service falls back to
# NoopSender, which logs the message instead of sending it.
FONNTE_TOKEN=
