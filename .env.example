# Copy to .env and adjust for local (non-Docker) runs. When running via
# docker-compose (deployments/docker/docker-compose.yml), these are already
# set per-service with container-network hostnames — this file is only for
# running an individual `go run ./cmd/server` outside Docker.

# --- Identity Service ---
# PORT=8081
# DATABASE_URL=postgres://identity:identity@localhost:5432/identity_db?sslmode=disable

# --- Core Service ---
# PORT=8082
# DATABASE_URL=postgres://core:core@localhost:5432/core_db?sslmode=disable

# --- Payment Service ---
# PORT=8083
# DATABASE_URL=postgres://payment:payment@localhost:5432/payment_db?sslmode=disable
# CORE_SERVICE_URL=http://localhost:8082

# --- Notification Service ---
# PORT=8084
# DATABASE_URL=postgres://notification:notification@localhost:5432/notification_db?sslmode=disable

# --- Reporting Service ---
# PORT=8085
# DATABASE_URL=postgres://reporting:reporting@localhost:5432/reporting_db?sslmode=disable

# --- Shared by every service above ---
# REDIS_ADDR=localhost:6379
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# LOG_LEVEL=info

# --- Gateway ---
# PORT=8080
# REDIS_ADDR=localhost:6379
# JWT_SIGNING_KEY=dev-only-insecure-key-change-me
# IDENTITY_UPSTREAM=http://localhost:8081
# CORE_UPSTREAM=http://localhost:8082
# PAYMENT_UPSTREAM=http://localhost:8083
# REPORTING_UPSTREAM=http://localhost:8085
# ALLOWED_ORIGIN=http://localhost:3000
# OPENAPI_SPEC_PATH=../docs/openapi.yaml
